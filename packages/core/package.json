{
  "name": "@open-education-standards/core",
  "version": "0.3.1",
  "description": "Types, schema validation, and reference resolution for OES (Open Education Standards) content.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "build-validators": "node scripts/build-validators.mjs",
    "pretypecheck": "npm run build-validators",
    "pretest": "npm run build-validators",
    "prebuild": "npm run build-validators",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@open-education-standards/schemas": "^0.1.2",
    "@types/node": "^22.10.5",
    "esbuild": "^0.27.7",
    "eslint": "^9.18.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  }
}
