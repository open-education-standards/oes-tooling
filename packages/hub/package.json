{
  "name": "@inklyre/oes-hub",
  "version": "0.1.0",
  "description": "Build and check a static OES hub: a set of files listing OPK packages that anyone can browse and import. Library plus the `oes-hub` CLI.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "oes-hub": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inklyre/oes-core": "^0.4.0",
    "@inklyre/oes-lint": "^0.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  }
}
