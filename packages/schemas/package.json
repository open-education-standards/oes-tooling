{
  "name": "@inklyre/oes-schemas",
  "version": "0.2.0",
  "description": "The JSON Schemas for OES (Open Education Standards), fetched from the spec repo (github.com/open-education-standards/oes) and packaged for npm consumption.",
  "license": "CC-BY-4.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "fetch-schemas": "node scripts/fetch-schemas.mjs",
    "pretypecheck": "npm run fetch-schemas",
    "pretest": "npm run fetch-schemas",
    "prebuild": "npm run fetch-schemas",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  }
}
